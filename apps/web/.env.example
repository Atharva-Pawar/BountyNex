# ------------------------------------------------------------------
# BountyNex - Frontend environment template (apps/web/.env.example)
# Copy to apps/web/.env and fill in values.
#
# SECURITY WARNING:
# Every VITE_* variable is inlined into the browser bundle and is
# publicly visible. NEVER put secrets here: no private keys, no
# DATABASE_URL, no JWT_SECRET, no Cloudinary secrets, no deployer keys.
# ------------------------------------------------------------------

# ---- REQUIRED immediately for local development ----

# Backend API base URL.
# - Leave EMPTY to use the Vite dev proxy: vite.config.ts forwards
#   /api -> http://localhost:4000 (backend default port, see
#   apps/server/src/config/env.ts).
# - OR set explicitly, e.g. VITE_API_URL=http://localhost:4000. The
#   server CORS allow-list includes http://localhost:5173.
VITE_API_URL=http://localhost:4000

# ---- Available after smart contract deployment ----

# Deployed BountyEscrow contract address on Sepolia.
# Comes from `npm run deploy:sepolia --workspace @bountynx/contracts`
# (see packages/contracts/scripts/deploy.ts). Until then leave empty -
# escrow features show "Blockchain configuration unavailable" and the
# rest of the app still works.
VITE_CONTRACT_ADDRESS=

# ---- Optional (sensible defaults exist in code) ----

# WalletConnect Cloud project ID (free, public identifier, NOT a
# secret). Get one at https://cloud.walletconnect.com. Leave empty to
# use RainbowKit's built-in fallback for local testing.
VITE_WALLET_CONNECT_PROJECT_ID=

# Sepolia RPC endpoint used by wagmi for blockchain reads/signatures.
# Empty falls back to https://sepolia.drpc.org.
VITE_RPC_URL=

# Sepolia block explorer used for transaction links.
# Empty falls back to https://sepolia.etherscan.io.
VITE_EXPLORER_URL=
