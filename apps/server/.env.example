# ------------------------------------------------------------------
# BountyNex - Backend environment template (apps/server/.env.example)
# Copy to apps/server/.env and fill in real values.
#
# SECURITY: this file is documentation and may be committed. The real
# file apps/server/.env is gitignored. NEVER put real credentials in
# this example and NEVER commit apps/server/.env.
# ------------------------------------------------------------------


# ===================== DATABASE =====================

# PostgreSQL connection string. Read by Prisma (schema.prisma) and the
# server boot-time env schema (zod). REQUIRED - the server will not
# start without it.
# Provider: your Postgres database (e.g. Neon neon.tech, Supabase,
# Railway, Render, or a local PostgreSQL install).
# SECRET - keep out of Git and never expose to the frontend.
DATABASE_URL=

# Disposable PostgreSQL/Neon database used ONLY by the test suite
# (vitest.config.ts + tests/global-setup.ts). REQUIRED to run
# `npm run test:server`; irrelevant for normal runtime.
# Provider: same Postgres providers as DATABASE_URL.
# SECRET.
DATABASE_URL_TEST=


# ===================== HTTP =====================

# Port the API listens on. Read by src/index.ts.
# Optional - code default is 4000.
# NOTE: the value is parsed with z.coerce.number(), so an EMPTY value
# becomes 0. Either set an explicit port or delete the line entirely to
# use the 4000 default.
PORT=

# Comma-separated list of allowed CORS origins for the web app.
# Read by src/app.ts.
# Optional - code default is http://localhost:5173.
CLIENT_ORIGIN=


# ===================== AUTH =====================

# JWT signing secret, minimum 16 characters. Read by src/utils/jwt.ts.
# REQUIRED - the server will not start without it.
# Provider: you (generate locally, e.g. `openssl rand -hex 32`).
# SECRET - never commit, never share, never expose to the frontend.
JWT_SECRET=

# JWT lifetime (e.g. 7d, 12h, 30m). Read by src/utils/jwt.ts.
# Optional - code default is 7d.
JWT_EXPIRES_IN=

# Name of the cookie that carries the auth token. Read by
# src/utils/cookies.ts.
# Optional - code default is bntnx_token.
JWT_COOKIE_NAME=

# Runtime mode: development | test | production. Read by
# src/config/env.ts, src/config/logger.ts, src/lib/prisma.ts.
# Optional - code default is development.
NODE_ENV=


# ===================== CLOUDINARY (evidence file uploads) =====================

# Cloudinary cloud name. Read by src/config/cloudinary.ts.
# Optional - if any of the three CLOUDINARY_* values is empty the
# upload service is disabled and report evidence upload fails gracefully.
# Provider: dashboard.cloudinary.com (free account).
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key. Read by src/config/cloudinary.ts.
# Optional - see CLOUDINARY_CLOUD_NAME.
# Provider: dashboard.cloudinary.com.
CLOUDINARY_API_KEY=

# Cloudinary API secret. Read by src/config/cloudinary.ts.
# Optional - see CLOUDINARY_CLOUD_NAME.
# Provider: dashboard.cloudinary.com.
# SECRET.
CLOUDINARY_API_SECRET=

# Upload folder inside your Cloudinary account. Read by
# src/services/cloudinary.service.ts.
# Optional - code default is bountynx-evidence.
CLOUDINARY_UPLOAD_FOLDER=


# ===================== ETHEREUM / SEPOLIA (on-chain escrow) =====================

# Sepolia RPC endpoint for blockchain reads/writes. Read by
# src/blockchain/client.ts. When empty (or combined with an empty
# BOUNTY_ESCROW_ADDRESS), on-chain features are disabled server-side.
# Optional - Provider: a free RPC service (Alchemy, Infura, PublicNode,
# drpc, etc.). Not a secret.
RPC_URL_SEPOLIA=

# Sepolia chain id. Read by src/blockchain/client.ts.
# Optional - code default is 11155111.
# NOTE: parsed with z.coerce.number(), an EMPTY value becomes 0. Either
# set an explicit value or delete the line to use the default.
CHAIN_ID_SEPOLIA=

# Deployed BountyEscrow contract address (0x...). Read by
# src/blockchain/client.ts. Only needed AFTER you deploy the contract
# (packages/contracts -> deployments/bounty-escrow.json). When empty,
# on-chain features are disabled server-side.
# Optional - Provider: your own contract deployment.
BOUNTY_ESCROW_ADDRESS=

# Sepolia block explorer used to build transaction links. Read by
# src/blockchain/client.ts.
# Optional - code default is https://sepolia.etherscan.io.
SEPOLIA_EXPLORER_URL=

# Etherscan API key. NOTE: declared in the server env schema but NOT
# read by any server code (the packages/contracts workspace consumes it
# for contract verification). Included here for reference only.
# Optional - Provider: etherscan.io. Treat as sensitive.
ETHERSCAN_API_KEY=


# ===================== RATE LIMITING =====================

# Rate-limit window in milliseconds. Read by src/middleware/rateLimit.ts.
# Optional - code default is 60000.
# NOTE: parsed with z.coerce.number(), an EMPTY value becomes 0. Either
# set an explicit value or delete the line to use the default.
RATE_LIMIT_WINDOW_MS=

# Maximum requests per window for general endpoints.
# Read by src/middleware/rateLimit.ts. Optional - code default is 100.
# NOTE: same empty-value coercion caveat as above.
RATE_LIMIT_MAX=

# Maximum requests per window for auth endpoints.
# Read by src/middleware/rateLimit.ts. Optional - code default is 10.
# NOTE: same empty-value coercion caveat as above.
RATE_LIMIT_AUTH_MAX=


# ===================== SEEDING (npm run db:seed) =====================

# Email of the admin user created by prisma/seed.ts.
# Optional - seeding only. If ADMIN_EMAIL and ADMIN_PASSWORD are both
# set, an admin is created; otherwise the seed skips admin creation.
ADMIN_EMAIL=

# Password for the seeded admin user. Seeding only.
# SECRET - use a strong, throwaway value.
ADMIN_PASSWORD=

# Display name for the seeded admin user. Seeding only.
# Optional - code default is "Platform Admin".
ADMIN_NAME=
