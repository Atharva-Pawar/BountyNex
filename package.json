{
  "name": "bountynx",
  "version": "1.0.0",
  "private": true,
  "description": "BountyNex - a decentralized bug bounty platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @bountynx/server",
    "dev:web": "npm run dev --workspace @bountynx/web",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "npm run test --workspace @bountynx/contracts",
    "test:server": "npm run test --workspace @bountynx/server",
    "test:web": "npm run test --workspace @bountynx/web",
    "db:migrate": "npm run db:migrate --workspace @bountynx/server",
    "db:generate": "npm run db:generate --workspace @bountynx/server",
    "db:studio": "npm run db:studio --workspace @bountynx/server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
